# Docker image — managed by CI/CD pipeline (do not edit manually in production)
DOCKER_USERNAME=ktshonln
IMAGE_TAG=latest

NODE_ENV=development
PORT=8100

# PostgreSQL — password for notification_svc user (host/db fixed: pgbouncer:6432/notification_db)
# Local value: see NOTIFICATION_DB_PASSWORD in ../db/docker-compose.override.yml
DB_PASSWORD=change_me

# Direct postgres URL — only needed for migration commands (prisma migrate dev/deploy).
# Bypasses PgBouncer so advisory locks and DDL work correctly.
# Local: postgresql://notification_svc:<DB_PASSWORD>@127.0.0.1:5432/notification_db
# In-container (katisha-net): postgresql://notification_svc:<DB_PASSWORD>@db:5432/notification_db
DIRECT_DATABASE_URL=postgresql://notification_svc:change_me@127.0.0.1:5432/notification_db

# Shadow DB for prisma migrate dev — needs a user with CREATEDB privilege.
# Use the postgres superuser; see POSTGRES_PASSWORD in ../db/docker-compose.override.yml
# SHADOW_DATABASE_URL=postgresql://katisha:change_me@127.0.0.1:5432/postgres

# RabbitMQ — credentials (host fixed: rabbitmq:5672)
RABBITMQ_USER=katisha
RABBITMQ_PASSWORD=change_me

# itecsms.rw SMS gateway
ITECSMS_API_KEY=your-api-key-here

# Resend email
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=Katisha <no-reply@katisha.rw>
LOGO_URL=https://your-cdn-or-host.example.com/logo-white.png
